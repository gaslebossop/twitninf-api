PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/twitninf
REDIS_URL=redis://localhost:6379

JWT_SECRET=your_secret_key_here
JWT_EXPIRY=24h
FRAUD_DATA_HASH_KEY=replace_with_an_independent_random_secret

RECOMMENDER_URL=http://localhost:3002

CORS_ORIGIN=http://localhost:3000

# Recherche de morceaux (La Forge : musique dans les tweets) — Client
# Credentials Flow, app Spotify sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Taille du pool de travail libuv (fs async, dns.lookup, sharp, zlib). Défaut
# Node : 4 — server.js retombe sur 16 si absent d'ici. À monter davantage si
# la production tourne sur plus de 8 coeurs (repère : coeurs x 2).
UV_THREADPOOL_SIZE=16
