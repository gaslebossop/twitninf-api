# Les valeurs ci-dessous sont les valeurs de production par défaut. Copier ce
# fichier vers /etc/default/twitninf-autoscaler pour les ajuster sans toucher au
# code. Une évaluation a lieu toutes les 5 secondes.
# 32 est une garde de ports/processus; la vraie limite est calculée avec la RAM.
AUTOSCALE_MAX_REPLICAS=32
AUTOSCALE_REPLICA_MEMORY_BUDGET_MB=1536
AUTOSCALE_MAX_SCALE_OUT_BATCH=1
AUTOSCALE_WINDOW_SECONDS=30
AUTOSCALE_MIN_REQUESTS_PER_SIDE=30
AUTOSCALE_HIGH_P95_SECONDS=0.8
AUTOSCALE_HIGH_ERROR_RATE=0.05
AUTOSCALE_HIGH_STREAK=1
AUTOSCALE_OUT_COOLDOWN_SECONDS=5

# Une réplique est retirée à la fois après 10 minutes stables ou sans trafic.
AUTOSCALE_LOW_P95_SECONDS=0.3
AUTOSCALE_LOW_ERROR_RATE=0.01
AUTOSCALE_LOW_STREAK=120
AUTOSCALE_IN_COOLDOWN_SECONDS=600

# A doit conserver une marge pour le worker, PostgreSQL, Redis et Nginx.
AUTOSCALE_MIN_AVAILABLE_BEFORE_MB=4608
AUTOSCALE_MIN_AVAILABLE_AFTER_MB=3072
AUTOSCALE_START_TIMEOUT_SECONDS=75
AUTOSCALE_WARMUP_SECONDS=3
AUTOSCALE_DRAIN_SECONDS=15
AUTOSCALE_MANUAL_LOCK_WAIT_SECONDS=10
AUTOSCALE_MANUAL_SCALE_OUT_PAUSE_SECONDS=90
