#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  echo "twitninf-infra-control doit etre execute en root" >&2
  exit 1
fi
if [[ $# -ne 1 ]]; then
  echo "usage: twitninf-infra-control {web|db}-{start|stop|restart}|db-{promote|primary-a|stop-local|rejoin-from-a}|status" >&2
  exit 2
fi

defaults=/etc/default/twitninf-infra-control
[[ -r "$defaults" ]] || { echo "configuration absente: $defaults" >&2; exit 1; }
# shellcheck source=/dev/null
source "$defaults"

: "${WEB_PROCESS:?WEB_PROCESS manquant}"
PM2_USER=${PM2_USER:-debian}
PM2_HOME=${PM2_HOME:-/home/debian/.pm2}
PG_CLUSTER=${PG_CLUSTER:-17/main}
PG_VERSION=${PG_CLUSTER%%/*}
PG_NAME=${PG_CLUSTER#*/}
PM2_BIN=${PM2_BIN:-/usr/bin/pm2}
NODE_ID=${NODE_ID:-A}
REMOTE_CONTROL_KEY=${REMOTE_CONTROL_KEY:-/home/debian/.ssh/twitninf-infra-control}
REMOTE_CONTROL_HOST=${REMOTE_CONTROL_HOST:-debian@10.8.0.2}

pm2_as_user() {
  runuser -u "$PM2_USER" -- env PM2_HOME="$PM2_HOME" "$PM2_BIN" "$@"
}

web_pid() {
  pm2_as_user pid "$WEB_PROCESS" 2>/dev/null | tail -n 1 | tr -d '[:space:]'
}

database_recovery_state() {
  runuser -u postgres -- /usr/bin/psql -Atqc 'select pg_is_in_recovery()' 2>/dev/null || true
}

remote_b() {
  runuser -u "$PM2_USER" -- /usr/bin/ssh \
    -i "$REMOTE_CONTROL_KEY" \
    -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=yes \
    "$REMOTE_CONTROL_HOST" "$1"
}

promote_local_database() {
  pg_ctlcluster "$PG_VERSION" "$PG_NAME" status >/dev/null 2>&1 || {
    echo "PostgreSQL local est arrete" >&2
    return 1
  }
  local recovery
  recovery=$(database_recovery_state)
  [[ "$recovery" == t ]] && pg_ctlcluster "$PG_VERSION" "$PG_NAME" promote
  for _ in {1..20}; do
    recovery=$(database_recovery_state)
    [[ "$recovery" == f ]] && break
    sleep 0.5
  done
  [[ "$recovery" == f ]] || { echo "promotion PostgreSQL impossible" >&2; return 1; }
  runuser -u postgres -- /usr/bin/psql -v ON_ERROR_STOP=1 -Atqc \
    "select pg_create_physical_replication_slot('vps_a') where not exists (select 1 from pg_replication_slots where slot_name='vps_a')" \
    >/dev/null
}

rejoin_a_from_b() {
  local data_dir=/var/lib/postgresql/17/main auto_conf recovery
  auto_conf="$data_dir/postgresql.auto.conf"
  pg_ctlcluster "$PG_VERSION" "$PG_NAME" status >/dev/null 2>&1 && {
    echo "A doit etre arrete avant pg_rewind" >&2
    return 1
  }
  runuser -u postgres -- /usr/lib/postgresql/17/bin/pg_rewind \
    --target-pgdata="$data_dir" \
    --source-server="host=10.8.0.2 port=5432 user=replicator dbname=postgres passfile=/var/lib/postgresql/.pgpass" \
    --write-recovery-conf --progress
  sed -i '/^[[:space:]]*primary_slot_name[[:space:]]*=/d' "$auto_conf"
  printf "%s\n" "primary_slot_name = 'vps_a'" >> "$auto_conf"
  chown postgres:postgres "$auto_conf"
  pg_ctlcluster "$PG_VERSION" "$PG_NAME" start
  for _ in {1..30}; do
    recovery=$(database_recovery_state)
    [[ "$recovery" == t ]] && return 0
    sleep 0.5
  done
  echo "A n'a pas rejoint B comme standby" >&2
  return 1
}

rejoin_b_from_a() {
  local data_dir=/var/lib/postgresql/17/main auto_conf recovery
  auto_conf="$data_dir/postgresql.auto.conf"
  pg_ctlcluster "$PG_VERSION" "$PG_NAME" status >/dev/null 2>&1 && {
    echo "B doit etre arrete avant pg_rewind" >&2
    return 1
  }
  runuser -u postgres -- /usr/lib/postgresql/17/bin/pg_rewind \
    --target-pgdata="$data_dir" \
    --source-server="host=10.8.0.1 port=5432 user=replicator dbname=postgres passfile=/var/lib/postgresql/.pgpass" \
    --write-recovery-conf --progress
  sed -i '/^[[:space:]]*primary_slot_name[[:space:]]*=/d' "$auto_conf"
  printf "%s\n" "primary_slot_name = 'vps_b'" >> "$auto_conf"
  chown postgres:postgres "$auto_conf"
  pg_ctlcluster "$PG_VERSION" "$PG_NAME" start
  for _ in {1..30}; do
    recovery=$(database_recovery_state)
    [[ "$recovery" == t ]] && return 0
    sleep 0.5
  done
  echo "B n'a pas rejoint A comme standby" >&2
  return 1
}

stop_local_for_switchover() {
  [[ "$(database_recovery_state)" == f ]] || {
    echo "Le noeud a arreter n'est pas primaire" >&2
    return 1
  }
  runuser -u postgres -- /usr/bin/psql -v ON_ERROR_STOP=1 -Atqc 'checkpoint' >/dev/null
  local target_lsn
  target_lsn=$(runuser -u postgres -- /usr/bin/psql -Atqc 'select pg_current_wal_lsn()')
  [[ "$target_lsn" =~ ^[0-9A-F]+/[0-9A-F]+$ ]] || return 1
  pg_ctlcluster --force "$PG_VERSION" "$PG_NAME" stop
  printf '%s\n' "$target_lsn"
}

make_a_primary() {
  [[ "$NODE_ID" == A ]] || { echo "failback disponible uniquement sur A" >&2; return 1; }
  [[ "$(database_recovery_state)" == t ]] || { echo "A n'est pas standby" >&2; return 1; }
  local target_lsn caught=false
  target_lsn=$(remote_b db-stop-local)
  [[ "$target_lsn" =~ ^[0-9A-F]+/[0-9A-F]+$ ]] || {
    remote_b db-start >/dev/null 2>&1 || true
    echo "LSN de bascule B invalide" >&2
    return 1
  }
  for _ in {1..30}; do
    caught=$(runuser -u postgres -- /usr/bin/psql -Atqc \
      "select pg_wal_lsn_diff(pg_last_wal_replay_lsn(),'$target_lsn') >= 0" 2>/dev/null || true)
    [[ "$caught" == t ]] && break
    sleep 0.5
  done
  if [[ "$caught" != t ]]; then
    remote_b db-start >/dev/null 2>&1 || true
    echo "A n'a pas rejoue le dernier WAL de B" >&2
    return 1
  fi
  pg_ctlcluster "$PG_VERSION" "$PG_NAME" promote
  runuser -u postgres -- /usr/bin/psql -v ON_ERROR_STOP=1 -Atqc \
    "select pg_create_physical_replication_slot('vps_b') where not exists (select 1 from pg_replication_slots where slot_name='vps_b')" \
    >/dev/null
  remote_b db-rejoin-from-a
}

web_online=false
pid=$(web_pid || true)
if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null; then
  web_online=true
fi
db_online=false
db_in_recovery=null
if pg_ctlcluster "$PG_VERSION" "$PG_NAME" status >/dev/null 2>&1; then
  db_online=true
  recovery=$(database_recovery_state)
  [[ "$recovery" == t ]] && db_in_recovery=true
  [[ "$recovery" == f ]] && db_in_recovery=false
fi

case "$1" in
  status)
    printf '{"web_online":%s,"db_online":%s,"db_in_recovery":%s,"web_process":"%s","pg_cluster":"%s","node":"%s"}\n' \
      "$web_online" "$db_online" "$db_in_recovery" "$WEB_PROCESS" "$PG_CLUSTER" "$NODE_ID"
    ;;
  web-start)
    pm2_as_user start "$WEB_PROCESS" --update-env >/dev/null
    ;;
  web-stop)
    pm2_as_user stop "$WEB_PROCESS" >/dev/null
    ;;
  web-restart)
    pm2_as_user restart "$WEB_PROCESS" --update-env >/dev/null
    ;;
  db-start)
    if [[ "$NODE_ID" == A ]] && remote_b status | grep -q '"db_in_recovery":false'; then
      rejoin_a_from_b
    else
      pg_ctlcluster "$PG_VERSION" "$PG_NAME" start
    fi
    ;;
  db-stop)
    if [[ "$NODE_ID" == A && "$db_in_recovery" == false ]]; then
      pg_ctlcluster --force "$PG_VERSION" "$PG_NAME" stop
      if ! remote_b db-promote; then
        pg_ctlcluster "$PG_VERSION" "$PG_NAME" start
        echo "B non promu, A a ete restaure" >&2
        exit 1
      fi
    else
      pg_ctlcluster --force "$PG_VERSION" "$PG_NAME" stop
    fi
    ;;
  db-restart)
    if [[ "$NODE_ID" == A && "$db_in_recovery" == false ]]; then
      pg_ctlcluster --force "$PG_VERSION" "$PG_NAME" stop
      if remote_b db-promote; then
        rejoin_a_from_b
      else
        pg_ctlcluster "$PG_VERSION" "$PG_NAME" start
        echo "B non promu, A a ete restaure" >&2
        exit 1
      fi
    else
      pg_ctlcluster --force "$PG_VERSION" "$PG_NAME" restart
    fi
    ;;
  db-promote)
    promote_local_database
    ;;
  db-stop-local)
    stop_local_for_switchover
    ;;
  db-rejoin-from-a)
    rejoin_b_from_a
    ;;
  db-primary-a)
    make_a_primary
    ;;
  *)
    echo "commande refusee" >&2
    exit 2
    ;;
esac
