{
  "name": "twitninf-api",
  "version": "1.0.0",
  "description": "API hypersophistiquée pour l'application twitninf",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "lint": "eslint src/",
    "build": "tsc",
    "migrate": "node src/database/migrate.js",
    "migrate:up": "node src/database/migrate.js up",
    "migrate:down": "node src/database/migrate.js down",
    "db:seed": "node src/database/seed.js",
    "db:seed:full": "node src/database/seed.js --full",
    "db:sync": "node test-db-sync.js",
    "db:test": "node test-db-node.js",
    "test:routes": "node test-routes.js",
    "test:tweets": "node test-tweets-system.js",
    "test:full": "npm run test:routes && npm run test:tweets",
    "test:fraud-load": "node scripts/simulateNfFraudLoad.js"
  },
  "keywords": [
    "twitninf",
    "api",
    "nodejs",
    "express",
    "postgresql",
    "jwt",
    "authentication",
    "tweets",
    "social-media",
    "notifications",
    "search"
  ],
  "author": "twitninf Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@google/genai": "^0.3.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cohere-ai": "^7.19.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "maplibre-gl": "^5.24.0",
    "ml-logistic-regression": "^2.0.0",
    "ml-matrix": "^6.12.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.1.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.4",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.8",
    "sequelize": "^6.35.0",
    "sequelize-pg-utilities": "^1.0.0",
    "sharp": "^0.32.5",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.5.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/__specs__/**/*.spec.js"
    ]
  }
}
