{
  "name": "twitninf-api",
  "version": "1.0.0",
  "description": "TwitNinf Backend API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "express": "^4.18.0",
    "typescript": "^5.0.0",
    "axios": "^1.6.0",
    "@prisma/client": "^5.0.0",
    "redis": "^4.6.0",
    "socket.io": "^4.6.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.0",
    "dotenv": "^16.0.0",
    "cors": "^2.8.0",
    "express-rate-limit": "^7.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.0.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^2.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0"
  }
}
