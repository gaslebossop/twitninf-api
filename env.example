# Configuration du serveur
NODE_ENV=development
PORT=3000
HOST=localhost
CORS_ORIGIN=*

# URLs publiques des médias (avatars / bannières) — domaine HTTPS
# PUBLIC_MEDIA_ORIGIN=https://twitninf.duckdns.org
# PUBLIC_BASE_URL=https://twitninf.duckdns.org

# Configuration PostgreSQL (VPS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twitninf
DB_USER=admin
DB_PASSWORD=remplacer_par_le_mot_de_passe_postgres
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Réplique optionnelle, réservée aux lectures analytiques explicitement sûres.
# Laisser DB_READ_HOST vide pour utiliser uniquement le primaire.
DB_READ_HOST=
DB_READ_PORT=5432
DB_READ_POOL_MAX=4

# Mettre à false sur les nœuds web qui ne doivent jamais exécuter PolicierCongo.
POLICIERCONGO_LOCAL_ENABLED=true

# Configuration JWT
JWT_SECRET=remplacer_par_openssl_rand_hex_64
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Configuration Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Configuration des emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Configuration des notifications push
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Configuration des logs
LOG_LEVEL=info
LOG_FILENAME=logs/app.log

# Configuration du cache
CACHE_TTL=300
CACHE_CHECK_PERIOD=600
CACHE_MAX_KEYS=1000

# Configuration des performances
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024
QUERY_TIMEOUT=30000
CONNECTION_TIMEOUT=10000

# ─── Secrets sortis du code (dépôt public) ──────────────────────────────────
# Pool de clés Gemini, séparées par des virgules. Sans cette variable, la
# modération et les résumés de recherche sont simplement désactivés.
GEMINI_API_KEYS=cle1,cle2,cle3

# Secret partagé avec le service Rust de recommandation. Doit être IDENTIQUE
# des deux côtés, sinon le tracking est accepté puis ignoré, sans erreur.
INTERNAL_SECRET=remplacer_par_openssl_rand_hex_32

# Session MegaLLM : le fichier src/megallm-client/megallm-session.json n'est
# plus versionné (il contient un cookie d'authentification). Le déposer à la
# main sur le serveur, sur le modèle de megallm-session.example.json.
