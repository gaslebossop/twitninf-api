# Configuration du serveur
NODE_ENV=development
PORT=3000
HOST=localhost
CORS_ORIGIN=*

# URLs publiques des médias (avatars / bannières) — domaine HTTPS
# PUBLIC_MEDIA_ORIGIN=https://twitninf.duckdns.org
# PUBLIC_BASE_URL=https://twitninf.duckdns.org

# Configuration PostgreSQL (VPS)
DB_HOST=51.255.48.125
DB_PORT=5432
DB_NAME=twitninf
DB_USER=admin
DB_PASSWORD=myytree88
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Configuration JWT
JWT_SECRET=twitninf-super-secret-key-2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Configuration Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Configuration des emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Configuration des notifications push
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Configuration des logs
LOG_LEVEL=info
LOG_FILENAME=logs/app.log

# Configuration du cache
CACHE_TTL=300
CACHE_CHECK_PERIOD=600
CACHE_MAX_KEYS=1000

# Configuration des performances
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024
QUERY_TIMEOUT=30000
CONNECTION_TIMEOUT=10000
